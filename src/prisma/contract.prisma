model Company {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  // "trial" | "legacy" | "starter" | "unlimited" -- plain String, matching
  // how role/status fields work everywhere else in this contract (no enums
  // used anywhere).
  plan        String            @default("trial")
  // Non-null only while a company is actively on a timed trial. Every
  // pre-existing company and every paid/manually-provisioned company has
  // this as null, so the trial-expiry check can never lock them out.
  trialEndsAt TimestamptzString?
  // Required at self-service signup (enforced in the signup endpoint, not
  // here -- pre-existing companies never uploaded one, so this stays
  // nullable at the schema level).
  logoBase64  String?
  logoMimeType String?
  // "mollie" | "stripe" | null. A company is on at most one provider at a
  // time, chosen once at checkout -- null for every company that has never
  // gone through billing (every pre-existing company, every company still
  // on trial).
  billingProvider       String?
  // The provider's own Customer id (Stripe "cus_..." / Mollie "cst_...").
  // Set synchronously at checkout time, before the manager is even
  // redirected -- both providers return the customer id immediately on
  // creation.
  billingCustomerId     String?
  // The provider's own Subscription id. Exists once checkout completes for
  // Stripe; for Mollie it doesn't exist until the webhook handler creates
  // it in reaction to the first successful payment.
  billingSubscriptionId String?
  // "monthly" | "yearly" | null -- same vocabulary as the marketing site's
  // own billing toggle state.
  billingInterval        String?
  // Billing HEALTH, distinct from `plan` (feature ENTITLEMENT). Null until
  // billingProvider is set. "active" | "past_due" | "canceled". Kept
  // separate so a temporarily failed renewal doesn't yank access on the
  // first failure -- only a canceled subscription extends the login
  // soft-lock (see identity/service.ts).
  subscriptionStatus     String?
  // Set only for a scheduled downgrade (e.g. unlimited -> starter): the
  // customer keeps their current (higher) plan's access until the
  // in-progress billing period they already paid for runs out, and only
  // then does the provider subscription actually switch to this lower
  // plan/interval. Null the rest of the time -- an upgrade never uses
  // this, since it takes effect (and is charged in full) immediately.
  pendingPlan            String?
  pendingInterval        String?
  users       User[]
  invites     Invite[]
  departments Department[]
  shiftTypes  ShiftType[]
  openShifts  OpenShift[]
  openShiftRequests OpenShiftRequest[]
  events      Event[]
  messages    Message[]

  createdAt   TimestamptzString @default(now())
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  firstName     String?
  lastName      String?
  email         String
  passwordHash  String
  role          String         @default("employee")
  avatarBase64  String?
  avatarMimeType String?
  phone         String?
  address       String?
  location      String?
  departmentId  Int?
  department    Department?    @relation(fields: [departmentId], references: [id])
  needsOnboarding Boolean       @default(false)
  active        Boolean        @default(true)
  lastSeenAt    TimestamptzString?
  managerId     Int?
  manager       User?          @relation("ManagerReports", fields: [managerId], references: [id])
  reports       User[]         @relation("ManagerReports")
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id])
  contracts     Contract[]
  payslips      Payslip[]
  shifts        Shift[]
  attendances   Attendance[]
  notifications Notification[]
  leaveRequests LeaveRequest[]
  invitesSent   Invite[]
  openShiftRequests OpenShiftRequest[]
  pushSubscriptions PushSubscription[]
  passwordResetRequests PasswordResetRequest[]
  backupToken   BackupToken?
  backupSnapshots BackupSnapshot[]
  messages      Message[]

  @@unique([email, companyId])
}

model Contract {
  id          Int                @id @default(autoincrement())
  role        String
  pdfBase64   String?
  pdfFilename String?
  userId      Int
  user        User               @relation(fields: [userId], references: [id])

  createdAt   TimestamptzString  @default(now())
  updatedAt   TimestamptzString  @default(now())
}

model Payslip {
  id          Int                @id @default(autoincrement())
  period      String
  pdfBase64   String?
  pdfFilename String?
  userId      Int
  user        User               @relation(fields: [userId], references: [id])

  createdAt   TimestamptzString  @default(now())
  updatedAt   TimestamptzString  @default(now())
}

model Shift {
  id               Int                @id @default(autoincrement())
  userId           Int
  user             User               @relation(fields: [userId], references: [id])
  startsAt         TimestamptzString
  endsAt           TimestamptzString
  breakMinutes     Int?
  shiftTypeId      Int?
  shiftType        ShiftType?         @relation(fields: [shiftTypeId], references: [id])
  // Set only when this shift was created by assigning an OpenShift slot;
  // deleting the slot nulls this out rather than deleting the shift.
  openShiftId      Int?
  openShift        OpenShift?         @relation(fields: [openShiftId], references: [id])
  attendance       Attendance[]
  noShowCheckedAt  TimestamptzString?

  createdAt        TimestamptzString  @default(now())
  updatedAt        TimestamptzString  @default(now())
}

model Attendance {
  id                        Int                @id @default(autoincrement())
  userId                    Int
  user                      User               @relation(fields: [userId], references: [id])
  shiftId                   Int
  shift                     Shift              @relation(fields: [shiftId], references: [id])
  clockIn                   TimestamptzString?
  clockOut                  TimestamptzString?
  clockInLat                Float?
  clockInLng                Float?
  clockOutLat               Float?
  clockOutLng               Float?
  missedClockOutNotifiedAt  TimestamptzString?
  manualEntry               Boolean            @default(false)

  createdAt                 TimestamptzString  @default(now())
  updatedAt                 TimestamptzString  @default(now())
}

model Notification {
  id             Int               @id @default(autoincrement())
  userId         Int
  user           User              @relation(fields: [userId], references: [id])
  message        String
  url            String?
  read           Boolean           @default(false)
  // Loosely correlates a missed clock-in/out notification back to the shift
  // it's about, so it can be cleared automatically once the employee
  // actually clocks in/out -- not a real FK, so a deleted shift doesn't
  // cascade or block here.
  relatedShiftId Int?

  createdAt      TimestamptzString @default(now())
}

model Invite {
  id        Int               @id @default(autoincrement())
  email     String
  token     String            @unique
  status    String            @default("pending")
  managerId Int
  manager   User              @relation(fields: [managerId], references: [id])
  companyId Int
  company   Company           @relation(fields: [companyId], references: [id])
  expiresAt TimestamptzString

  createdAt TimestamptzString @default(now())
}

model PushSubscription {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  endpoint  String            @unique
  p256dh    String
  auth      String

  createdAt TimestamptzString @default(now())
}

model PasswordResetRequest {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  token     String            @unique
  status    String            @default("pending")
  expiresAt TimestamptzString

  createdAt TimestamptzString @default(now())
}

model BackupToken {
  id         Int                @id @default(autoincrement())
  userId     Int                @unique
  user       User               @relation(fields: [userId], references: [id])
  token      String             @unique
  createdAt  TimestamptzString  @default(now())
  lastUsedAt TimestamptzString?
}

model BackupSnapshot {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id])
  csv       String
  createdAt TimestamptzString  @default(now())
}

model LeaveRequest {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id])
  type      String
  startDate TimestamptzString
  endDate   TimestamptzString
  reason    String?
  status    String             @default("pending")

  createdAt TimestamptzString  @default(now())
  updatedAt TimestamptzString  @default(now())
}

model Department {
  id         Int         @id @default(autoincrement())
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id])
  name       String
  // Hex color string (e.g. "#4f46e5"), validated at the Zod layer -- matching
  // how every other "type-like" field in this contract is a plain String.
  color      String
  order      Int         @default(0)
  users      User[]
  openShifts OpenShift[]

  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@unique([companyId, name])
}

model ShiftType {
  id         Int         @id @default(autoincrement())
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id])
  name       String
  color      String
  order      Int         @default(0)
  shifts     Shift[]
  openShifts OpenShift[]

  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@unique([companyId, name])
}

model OpenShift {
  id            Int                @id @default(autoincrement())
  companyId     Int
  company       Company            @relation(fields: [companyId], references: [id])
  departmentId  Int?
  department    Department?        @relation(fields: [departmentId], references: [id])
  shiftTypeId   Int?
  shiftType     ShiftType?         @relation(fields: [shiftTypeId], references: [id])
  startsAt      TimestamptzString
  endsAt        TimestamptzString
  breakMinutes  Int?
  // How many people this slot needs; "filled" is derived by counting Shift
  // rows whose openShiftId points back here, not stored redundantly.
  requiredCount Int                @default(1)
  notes         String?
  shifts        Shift[]
  requests      OpenShiftRequest[]

  createdAt     TimestamptzString  @default(now())
  updatedAt     TimestamptzString  @default(now())
}

model OpenShiftRequest {
  id          Int         @id @default(autoincrement())
  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])
  openShiftId Int
  openShift   OpenShift   @relation(fields: [openShiftId], references: [id])
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  // "pending" | "approved" | "rejected" -- plain String, matching how every
  // other status-like field in this contract works (no enums used anywhere).
  status      String      @default("pending")

  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())
}

model Event {
  id        Int                @id @default(autoincrement())
  companyId Int
  company   Company            @relation(fields: [companyId], references: [id])
  title     String
  startsAt  TimestamptzString
  // Null endsAt = a single-moment marker banner, not a time range.
  endsAt    TimestamptzString?

  createdAt TimestamptzString  @default(now())
  updatedAt TimestamptzString  @default(now())
}

// One shared company-wide chat stream -- no per-thread/DM model, every
// employee in the company reads and posts to the same feed. Kept as a flat
// list rather than a paginated "conversation" concept since scope is
// explicitly a single channel per company, not a messaging inbox.
model Message {
  id        Int               @id @default(autoincrement())
  companyId Int
  company   Company           @relation(fields: [companyId], references: [id])
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  body      String

  createdAt TimestamptzString @default(now())
}

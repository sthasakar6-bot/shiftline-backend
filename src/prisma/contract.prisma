model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("employee")
  avatarBase64  String?
  avatarMimeType String?
  managerId     Int?
  manager       User?          @relation("ManagerReports", fields: [managerId], references: [id])
  reports       User[]         @relation("ManagerReports")
  contracts     Contract[]
  shifts        Shift[]
  attendances   Attendance[]
  notifications Notification[]
  leaveRequests LeaveRequest[]
  invitesSent   Invite[]
  pushSubscriptions PushSubscription[]
  passwordResetRequests PasswordResetRequest[]
}

model Contract {
  id          Int                @id @default(autoincrement())
  role        String
  pdfBase64   String?
  pdfFilename String?
  userId      Int
  user        User               @relation(fields: [userId], references: [id])

  createdAt   TimestamptzString  @default(now())
  updatedAt   TimestamptzString  @default(now())
}

model Shift {
  id           Int                @id @default(autoincrement())
  userId       Int
  user         User               @relation(fields: [userId], references: [id])
  startsAt     TimestamptzString
  endsAt       TimestamptzString
  breakMinutes Int?
  attendance   Attendance[]

  createdAt    TimestamptzString  @default(now())
  updatedAt    TimestamptzString  @default(now())
}

model Attendance {
  id          Int                @id @default(autoincrement())
  userId      Int
  user        User               @relation(fields: [userId], references: [id])
  shiftId     Int
  shift       Shift              @relation(fields: [shiftId], references: [id])
  clockIn     TimestamptzString?
  clockOut    TimestamptzString?
  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?

  createdAt   TimestamptzString  @default(now())
  updatedAt   TimestamptzString  @default(now())
}

model Notification {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  message   String
  url       String?
  read      Boolean           @default(false)

  createdAt TimestamptzString @default(now())
}

model Invite {
  id        Int               @id @default(autoincrement())
  email     String
  token     String            @unique
  status    String            @default("pending")
  managerId Int
  manager   User              @relation(fields: [managerId], references: [id])
  expiresAt TimestamptzString

  createdAt TimestamptzString @default(now())
}

model PushSubscription {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  endpoint  String            @unique
  p256dh    String
  auth      String

  createdAt TimestamptzString @default(now())
}

model PasswordResetRequest {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  token     String            @unique
  status    String            @default("pending")
  expiresAt TimestamptzString

  createdAt TimestamptzString @default(now())
}

model LeaveRequest {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id])
  type      String
  startDate TimestamptzString
  endDate   TimestamptzString
  reason    String?
  status    String             @default("pending")

  createdAt TimestamptzString  @default(now())
  updatedAt TimestamptzString  @default(now())
}

# Copy this file to `.env` and fill in real values.

# PostgreSQL connection string. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production than in local dev.
JWT_SECRET=

# Port the server listens on. Most hosting platforms (Railway included) set this
# automatically - only set it yourself for local dev if you want something other than 3000.
PORT=3000

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave unset in local dev (reflects any origin). Set this once you have a real frontend.
CORS_ORIGIN=

# Public URL of the app (used to build billing checkout redirect URLs).
APP_URL=https://app.shiftline.nl

# Mollie test/live API key (Dashboard -> Developers -> API keys) and the
# signing secret for the webhook endpoint registered at
# POST /api/billing/webhooks/mollie (set once that's registered).
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# Stripe test/live secret key (Dashboard -> Developers -> API keys) and the
# signing secret for the webhook endpoint registered at
# POST /api/billing/webhooks/stripe (set once that's registered).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each plan x interval (Dashboard -> Product catalog).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_YEARLY=

# Stripe Price ID for the AI assistant add-on (flat monthly, no yearly
# variant). Reuses the same webhook endpoint/secret above -- no separate
# webhook registration needed.
STRIPE_PRICE_AI_ASSISTANT_MONTHLY=

# Anthropic API key (console.anthropic.com) for the AI scheduling
# assistant. Separate from any Claude Pro subscription -- this is
# pay-per-token API billing.
ANTHROPIC_API_KEY=
